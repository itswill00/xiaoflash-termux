#!/data/data/com.termux/files/usr/bin/python3
import os
import sys
import time
import signal

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from core.fastboot_otg import FastbootOTG
from core.arb_checker import ARBChecker
from core.rom_extractor import ROMExtractor
from core.rom_downloader import ROMDownloader
from core.boot_patcher import BootPatcher
from core.ui_menu import console, render_header, show_main_menu
from rich.prompt import Prompt, Confirm

fastboot_instance = None

def graceful_exit(signum=None, frame=None):
    global fastboot_instance
    if fastboot_instance:
        try:
            fastboot_instance.py_fb.dispose()
        except:
            pass
    sys.exit(0)

signal.signal(signal.SIGINT, graceful_exit)
signal.signal(signal.SIGTERM, graceful_exit)

def main():
    global fastboot_instance
    fastboot_instance = FastbootOTG()
    device, msg = fastboot_instance.scan_devices()

    while True:
        try:
            render_header(device)
            choice = show_main_menu()

            if choice == "1":
                console.print("\n-- Flash ROM Package --")
                rom_path = Prompt.ask("ROM path (.tgz / .tar.gz / folder)", default="/sdcard/Download/ginkgo_global_images.tgz")

                if not os.path.exists(rom_path):
                    console.print(f"[yellow]Error: Path '{rom_path}' does not exist on storage.[/yellow]")
                    input("Press Enter to return...")
                    continue

                target_dir = rom_path
                if os.path.isfile(rom_path) and (rom_path.endswith('.tgz') or rom_path.endswith('.tar.gz') or rom_path.endswith('.zip')):
                    base_name = os.path.basename(rom_path).split('.')[0]
                    target_dir = f"/sdcard/Download/{base_name}_extracted"
                    console.print(f"Extracting package to '{target_dir}'...")
                    ok_ext, err_ext = ROMExtractor.extract_rom(rom_path, target_dir, progress_callback=lambda m, s: console.print(f"[{s}] {m}"))
                    if not ok_ext:
                        console.print(f"[red]Extraction error: {err_ext}[/red]")
                        input("Press Enter to return...")
                        continue

                console.print("\nFlashing Modes:")
                console.print("  1. flash_all                [Clean install / Wipe data]")
                console.print("  2. flash_all_except_storage [Preserve user storage]")
                console.print("  3. flash_all_lock           [Clean install + Lock bootloader]")
                
                mode_choice = Prompt.ask("Select mode", choices=["1", "2", "3"], default="1")
                mode_map = {"1": "flash_all", "2": "flash_all_except_data_storage", "3": "flash_all_lock"}
                mode = mode_map[mode_choice]

                safe, arb_msg, level = ARBChecker.verify_safety(device["anti"] if device else 1, 1)
                if not safe:
                    console.print(f"\n[red]{arb_msg}[/red]")
                    input("Press Enter to return...")
                    continue

                partitions = ROMExtractor.parse_flash_script(target_dir, mode)
                if not partitions:
                    console.print("[yellow]Script not found. Scanning image folder...[/yellow]")
                    img_dir = os.path.join(target_dir, "images") if os.path.exists(os.path.join(target_dir, "images")) else target_dir
                    for root, _, files in os.walk(img_dir):
                        for f in files:
                            if f.endswith('.img') or f.endswith('.bin'):
                                part_n = f.replace('.img', '').replace('.bin', '')
                                partitions.append((part_n, os.path.join(root, f)))

                if not partitions:
                    console.print("[red]Error: No flashable partition images found.[/red]")
                    input("Press Enter to return...")
                    continue

                dev_name = device["name"] if device else "Target"
                console.print(f"\nTarget: {dev_name} ({device['product'] if device else 'ginkgo'})")
                console.print(f"Mode  : {mode}")
                console.print(f"Count : {len(partitions)} partition(s) ready to flash")

                if Confirm.ask(f"\nProceed with flashing?"):
                    console.print(f"\nInitiating fastboot flash sequence...")
                    start_time = time.time()

                    serial = device["serial"] if device else "11bb599a"
                    is_simulated = device.get("is_simulated", False) if device else False

                    total = len(partitions)
                    success_count = 0

                    for idx, (part_name, img_file) in enumerate(partitions, start=1):
                        if mode == "flash_all_except_data_storage" and part_name == "userdata":
                            console.print(f"[{idx}/{total}] Skip {part_name} (Preserve User Data)")
                            continue

                        img_full = img_file if os.path.isabs(img_file) else os.path.join(target_dir, img_file)
                        img_size_mb = f"{os.path.getsize(img_full) / (1024*1024):.1f}MB" if os.path.exists(img_full) else "N/A"

                        def log_cb(msg, status):
                            if status == "process":
                                sys.stdout.write(f"\r[{idx}/{total}] {part_name:<12} ({img_size_mb}) • {msg}")
                                sys.stdout.flush()
                            elif status == "success":
                                console.print(f"\r[{idx}/{total}] {part_name:<12} ({img_size_mb}) • [green]OKAY[/green]")
                            elif status == "error":
                                console.print(f"\r[{idx}/{total}] {part_name:<12} ({img_size_mb}) • [red]FAIL ({msg})[/red]")

                        ok_p, _ = fastboot_instance.flash_partition(serial, part_name, img_full, is_simulated=is_simulated, callback=log_cb)
                        if ok_p:
                            success_count += 1

                    elapsed = time.time() - start_time
                    console.print(f"\n[green]Flashing completed in {elapsed:.1f}s ({success_count}/{total} partitions OK).[/green]")

                    if Confirm.ask("Reboot target device now?"):
                        fastboot_instance.reboot(serial, "system", is_simulated=is_simulated)
                        console.print("[green]Reboot command sent to device.[/green]")

            elif choice == "2":
                console.print("\n-- Download Official ROM --")

                detected_code, smart_roms = ROMDownloader.get_smart_recommendations(device)

                if detected_code and smart_roms:
                    console.print(f"Auto-detected device: [cyan]{device['name']}[/cyan] ({detected_code})")
                    results = smart_roms
                else:
                    query = Prompt.ask("Search model or codename", default="ginkgo")
                    results = ROMDownloader.search_roms(query)

                if not results:
                    console.print("No ROMs found matching query.")
                else:
                    console.print(f"\nAvailable ROMs ({len(results)} found):\n")
                    for idx, r in enumerate(results[:15], start=1):
                        console.print(f"  {idx}. {r['version']} | {r['region']} | {r['os']} | Size: {r['size']}")

                    dl_choice = Prompt.ask("\nSelect index (0 to cancel)", choices=[str(i) for i in range(len(results[:15]) + 1)], default="1")
                    if dl_choice != "0":
                        selected_rom = results[int(dl_choice) - 1]
                        ok, downloaded_path = ROMDownloader.download_rom(selected_rom)

                        if ok and Confirm.ask("\nExtract downloaded ROM archive now?"):
                            extract_dir = f"/sdcard/Download/{selected_rom['codename']}_extracted"
                            console.print(f"Extracting to '{extract_dir}'...")
                            ROMExtractor.extract_rom(downloaded_path, extract_dir, progress_callback=lambda m, s: console.print(f"[{s}] {m}"))

            elif choice == "3":
                console.print("\n-- Root Device --")
                boot_path = Prompt.ask("Boot image path", default="/sdcard/Download/boot.img")
                root_type = Prompt.ask("Method", choices=["magisk", "kernelsu"], default="magisk")

                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False

                if Confirm.ask(f"Patch '{boot_path}' with {root_type.upper()} and flash via OTG?"):
                    BootPatcher.patch_and_flash(fastboot_instance, serial, boot_path, root_type=root_type, is_simulated=is_simulated)

            elif choice == "4":
                console.print("\n-- Flash Single Image --")
                partition = Prompt.ask("Partition name", default="boot")
                img_path = Prompt.ask("Image file path", default="/sdcard/Download/boot.img")

                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False

                if Confirm.ask(f"Flash '{img_path}' -> {partition}?"):
                    def cb(m, s):
                        if s == "success":
                            console.print(f"{partition} OKAY")
                        elif s == "error":
                            console.print(f"{partition} FAIL: {m}")
                    fastboot_instance.flash_partition(serial, partition, img_path, is_simulated=is_simulated, callback=cb)

            elif choice == "5":
                console.print("\n-- Reboot Device --")
                console.print("  1. System")
                console.print("  2. Bootloader")
                console.print("  3. Recovery")
                res_c = Prompt.ask("Reboot target", choices=["1", "2", "3"], default="1")
                
                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False
                target_map = {"1": "system", "2": "bootloader", "3": "recovery"}

                ok, res_out = fastboot_instance.reboot(serial, target_map[res_c], is_simulated=is_simulated)
                if ok:
                    console.print("[green]Reboot command sent.[/green]")
                else:
                    console.print(f"[red]Reboot failed: {res_out}[/red]")

            elif choice == "6":
                console.print("\n-- Device Info & Security --")
                if device:
                    console.print(f"  Model       : {device['name']} ({device['product']})")
                    console.print(f"  Serial      : {device['serial']}")
                    console.print(f"  Anti-Roll   : v{device['anti']}")
                    console.print(f"  Bootloader  : {device['unlocked'].upper()}")
                    console.print(f"  Battery     : {device['battery']}")
                    console.print(f"  Driver Engine: {device['mode']}")

            elif choice == "0":
                graceful_exit()

            input("\nPress Enter to continue...")
            device, msg = fastboot_instance.scan_devices()

        except (KeyboardInterrupt, EOFError):
            graceful_exit()

if __name__ == "__main__":
    main()
