#!/data/data/com.termux/files/usr/bin/python3
import os
import sys
import time
import signal
import shutil

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Auto Root Elevation check inside Python entrypoint
if os.geteuid() != 0:
    su_bin = shutil.which("su") or "/system/bin/su"
    if os.path.exists(su_bin):
        script_file = os.path.abspath(__file__)
        args_str = " ".join(f'"{a}"' for a in sys.argv[1:])
        cmd = f"export PATH=/data/data/com.termux/files/usr/bin:$PATH; export LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib; export HOME=/data/data/com.termux/files/home; export ANDROID_USER_HOME=/data/data/com.termux/files/home/.android; python3 \"{script_file}\" {args_str}".strip()
        os.execv(su_bin, [su_bin, "-c", cmd])

from core.fastboot_otg import FastbootOTG
from core.arb_checker import ARBChecker
from core.rom_extractor import ROMExtractor
from core.rom_downloader import ROMDownloader
from core.boot_patcher import BootPatcher
from core.fastboot_shell import FastbootShell
from core.tui_engine import TUIEngine
from core.ui_menu import console, render_header, render_section_header, show_main_menu, clear_screen
from rich.prompt import Prompt, Confirm

fastboot_instance = None

def graceful_exit(signum=None, frame=None):
    global fastboot_instance
    if fastboot_instance:
        try:
            fastboot_instance.py_fb.dispose()
        except:
            pass
    clear_screen()
    console.print("\n[dim]Exiting XiaoFlash... Bye![/dim]\n")
    sys.exit(0)

signal.signal(signal.SIGINT, graceful_exit)
signal.signal(signal.SIGTERM, graceful_exit)

def format_size(bytes_val):
    if bytes_val < 1024 * 1024:
        return f"{bytes_val / 1024:.1f} KB"
    elif bytes_val < 1024 * 1024 * 1024:
        return f"{bytes_val / (1024 * 1024):.1f} MB"
    else:
        return f"{bytes_val / (1024 * 1024 * 1024):.2f} GB"

def main():
    global fastboot_instance
    fastboot_instance = FastbootOTG()
    device, msg = fastboot_instance.scan_devices()

    while True:
        try:
            choice = show_main_menu(device)

            if choice == "1":
                rom_picker_opts = [
                    ("browse_file", "📁 Browse ROM Package File (.tgz / .tar.gz / .zip)", "Interactive File Picker"),
                    ("browse_dir", "📁 Browse Extracted ROM Directory", "Interactive Folder Picker"),
                    ("manual", "✍️ Type Path Manually", "Text prompt"),
                    ("0", "0. Back to Main Menu", "")
                ]

                rom_pick_mode = TUIEngine.select_option(rom_picker_opts, header_render_fn=lambda: render_section_header(device, "Select ROM Source"), title="ROM Source")

                if rom_pick_mode == "0":
                    continue

                rom_path = None
                if rom_pick_mode == "browse_file":
                    rom_path = TUIEngine.file_browser("/sdcard/Download", allowed_exts=['.tgz', '.tar.gz', '.zip'], header_render_fn=lambda: render_section_header(device, "Select ROM Archive File"), title="ROM File Picker")
                elif rom_pick_mode == "browse_dir":
                    rom_path = TUIEngine.file_browser("/sdcard/Download", select_dir_mode=True, header_render_fn=lambda: render_section_header(device, "Select Extracted ROM Folder"), title="ROM Folder Picker")
                elif rom_pick_mode == "manual":
                    render_section_header(device, "Type ROM Path Manually")
                    rom_path = Prompt.ask("ROM path (.tgz / .tar.gz / folder)", default="/sdcard/Download/ginkgo_global_images.tgz")

                if not rom_path or rom_path.strip().lower() in ("0", "b", "back", "exit", "q"):
                    continue

                if not os.path.exists(rom_path):
                    console.print(f"\n[yellow]Error: Path '{rom_path}' does not exist on storage.[/yellow]")
                    Prompt.ask("\nPress Enter to return", default="")
                    continue

                target_dir = rom_path
                if os.path.isfile(rom_path) and (rom_path.endswith('.tgz') or rom_path.endswith('.tar.gz') or rom_path.endswith('.zip')):
                    base_name = os.path.basename(rom_path).split('.')[0]
                    target_dir = f"/sdcard/Download/{base_name}_extracted"
                    console.print(f"Extracting package to '{target_dir}'...")
                    ok_ext, err_ext = ROMExtractor.extract_rom(rom_path, target_dir, progress_callback=lambda m, s: console.print(f"[{s}] {m}"))
                    if not ok_ext:
                        console.print(f"\n[red]Extraction error: {err_ext}[/red]")
                        Prompt.ask("\nPress Enter to return", default="")
                        continue

                mode_opts = [
                    ("1", "flash_all", "[Clean install / Wipe data]"),
                    ("2", "flash_all_except_data_storage", "[Preserve user storage]"),
                    ("3", "flash_all_lock", "[Clean install + Lock bootloader]"),
                    ("0", "0. Back to Main Menu", "")
                ]

                mode_choice = TUIEngine.select_option(mode_opts, header_render_fn=lambda: render_section_header(device, "Select Flashing Mode"), title="Flashing Mode")
                if mode_choice == "0":
                    continue

                mode = mode_choice

                # Battery Voltage Safety Check
                batt_str = device.get("battery", "4000 mV") if device else "4000 mV"
                try:
                    batt_mv = int("".join(c for c in batt_str if c.isdigit()))
                    if 1000 < batt_mv < 3500:
                        console.print(f"\n[bold yellow]Warning: Target battery is low ({batt_mv} mV).[/bold yellow]")
                        console.print("[dim]It is recommended to charge target phone above 3700 mV before flashing.[/dim]")
                        if not Confirm.ask("Proceed anyway at your own risk?"):
                            continue
                except:
                    pass

                # Anti-Rollback Security Check
                safe, arb_msg, level = ARBChecker.verify_safety(device["anti"] if device else 1, 1)
                if not safe:
                    console.print(f"\n[red]{arb_msg}[/red]")
                    Prompt.ask("\nPress Enter to return", default="")
                    continue

                actions = ROMExtractor.parse_flash_script(target_dir, mode)
                if not actions:
                    console.print("[yellow]Script not found. Scanning image folder...[/yellow]")
                    img_dir = os.path.join(target_dir, "images") if os.path.exists(os.path.join(target_dir, "images")) else target_dir
                    for root, _, files in os.walk(img_dir):
                        for f in files:
                            if f.endswith('.img') or f.endswith('.bin'):
                                part_n = f.replace('.img', '').replace('.bin', '')
                                actions.append(("flash", part_n, os.path.join(root, f)))

                if not actions:
                    console.print("[red]Error: No flashable partition images found.[/red]")
                    Prompt.ask("\nPress Enter to return", default="")
                    continue

                dev_name = device["name"] if device else "Target"
                is_simulated = device.get("is_simulated", False) if device else False
                serial = device["serial"] if device else "11bb599a"

                render_section_header(device, "Confirm Flashing")
                console.print(f"Target: [cyan]{dev_name}[/cyan] ({device['product'] if device else 'ginkgo'})")
                console.print(f"Mode  : [yellow]{mode}[/yellow]")
                console.print(f"Count : [green]{len(actions)}[/green] action(s) ready to execute")
                if is_simulated:
                    console.print("[yellow]Note  : SIMULATION MODE ACTIVE (No physical USB OTG connected)[/yellow]")

                if Confirm.ask(f"\nProceed with flashing?"):
                    render_section_header(device, "Flashing Progress")
                    console.print(f"Initiating fastboot sequence ({len(actions)} actions)...\n")
                    start_time = time.time()

                    total = len(actions)
                    success_count = 0

                    for idx, (action_type, part_name, img_file) in enumerate(actions, start=1):
                        if mode == "flash_all_except_data_storage" and part_name == "userdata":
                            console.print(f"  [{idx}/{total}] {part_name:<12} [dim]SKIP (Preserve User Data)[/dim]")
                            continue

                        if action_type == "erase":
                            sys.stdout.write(f"  [{idx}/{total}] erase {part_name:<6} ... ")
                            sys.stdout.flush()
                            ok_p, err_p = fastboot_instance.erase_partition(serial, part_name, is_simulated=is_simulated)
                            if ok_p:
                                success_count += 1
                                console.print("[bold green]OKAY[/bold green]")
                            else:
                                console.print(f"[bold red]FAIL ({err_p})[/bold red]")
                        else:
                            img_full = img_file if os.path.isabs(img_file) else os.path.join(target_dir, img_file)
                            img_size_str = format_size(os.path.getsize(img_full)) if os.path.exists(img_full) else "N/A"

                            sys.stdout.write(f"  [{idx}/{total}] {part_name:<12} ({img_size_str:<8}) ... ")
                            sys.stdout.flush()

                            def log_cb(msg, status):
                                pass

                            ok_p, err_p = fastboot_instance.flash_partition(serial, part_name, img_full, is_simulated=is_simulated, callback=log_cb)
                            if ok_p:
                                success_count += 1
                                console.print("[bold green]OKAY[/bold green]")
                            else:
                                console.print(f"[bold red]FAIL ({err_p})[/bold red]")

                    elapsed = time.time() - start_time
                    console.print(f"\n[green]Flashing completed in {elapsed:.1f}s ({success_count}/{total} actions OK).[/green]")

                    if Confirm.ask("\nReboot target device now?"):
                        fastboot_instance.reboot(serial, "system", is_simulated=is_simulated)
                        console.print("[green]Reboot command sent to device.[/green]")

            elif choice == "2":
                render_section_header(device, "Download Official ROM")

                detected_code, smart_roms = ROMDownloader.get_smart_recommendations(device)

                if detected_code and smart_roms:
                    console.print(f"Auto-detected device: [cyan]{device['name']}[/cyan] ({detected_code})")
                    results = smart_roms
                else:
                    query = Prompt.ask("Search model or codename (or '0' to back)", default="ginkgo")
                    if query.strip() in ("0", "b", "back", "q"):
                        continue
                    results = ROMDownloader.search_roms(query)

                if not results:
                    console.print("No ROMs found matching query.")
                else:
                    rom_dl_opts = [(str(idx), f"{r['version']} | {r['region']} | {r['os']}", f"Size: {r['size']}") for idx, r in enumerate(results[:15], start=1)]
                    rom_dl_opts.append(("0", "0. Back to Main Menu", ""))

                    dl_choice = TUIEngine.select_option(rom_dl_opts, header_render_fn=lambda: render_section_header(device, "Select Official ROM to Download"), title="ROM Download Picker")

                    if dl_choice != "0":
                        selected_rom = results[int(dl_choice) - 1]
                        ok, downloaded_path = ROMDownloader.download_rom(selected_rom)

                        if ok and Confirm.ask("\nExtract downloaded ROM archive now?"):
                            extract_dir = f"/sdcard/Download/{selected_rom['codename']}_extracted"
                            console.print(f"Extracting to '{extract_dir}'...")
                            ROMExtractor.extract_rom(downloaded_path, extract_dir, progress_callback=lambda m, s: console.print(f"[{s}] {m}"))

            elif choice == "3":
                root_picker_opts = [
                    ("browse", "📁 Browse Boot Image File (.img)", "Interactive File Picker"),
                    ("manual", "✍️ Type Boot Image Path Manually", "Text prompt"),
                    ("0", "0. Back to Main Menu", "")
                ]

                root_pick = TUIEngine.select_option(root_picker_opts, header_render_fn=lambda: render_section_header(device, "Root Device - Select Boot Image"), title="Boot Image Picker")
                if root_pick == "0":
                    continue

                boot_path = None
                if root_pick == "browse":
                    boot_path = TUIEngine.file_browser("/sdcard/Download", allowed_exts=['.img'], header_render_fn=lambda: render_section_header(device, "Select Boot Image File"), title="Boot Image Browser")
                elif root_pick == "manual":
                    render_section_header(device, "Type Boot Image Path")
                    boot_path = Prompt.ask("Boot image path", default="/sdcard/Download/boot.img")

                if not boot_path or boot_path.strip() in ("0", "b", "back", "q"):
                    continue

                root_opts = [
                    ("magisk", "Magisk Root", "Patch boot image with Magisk"),
                    ("kernelsu", "KernelSU Root", "Patch boot image with KernelSU"),
                    ("0", "0. Back to Main Menu", "")
                ]

                root_type = TUIEngine.select_option(root_opts, header_render_fn=lambda: render_section_header(device, "Select Root Method"), title="Root Method")
                if root_type == "0":
                    continue

                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False

                if Confirm.ask(f"Patch '{boot_path}' with {root_type.upper()} and flash via OTG?"):
                    BootPatcher.patch_and_flash(fastboot_instance, serial, boot_path, root_type=root_type, is_simulated=is_simulated)

            elif choice == "4":
                partition = Prompt.ask("Partition name", default="boot")
                if partition.strip() in ("0", "b", "back", "q"):
                    continue

                img_path = TUIEngine.file_browser("/sdcard/Download", allowed_exts=['.img'], header_render_fn=lambda: render_section_header(device, f"Select Image File for '{partition}'"), title="Single Partition File Browser")
                if not img_path:
                    continue

                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False

                if Confirm.ask(f"Flash '{img_path}' -> {partition}?"):
                    def cb(m, s):
                        if s == "success":
                            console.print(f"{partition} OKAY")
                        elif s == "error":
                            console.print(f"{partition} FAIL: {m}")
                    fastboot_instance.flash_partition(serial, partition, img_path, is_simulated=is_simulated, callback=cb)

            elif choice == "5":
                reboot_opts = [
                    ("1", "System", "Normal reboot into Android OS"),
                    ("2", "Bootloader / Fastboot", "Reboot target into Fastboot mode"),
                    ("3", "Recovery", "Reboot target into Recovery mode"),
                    ("0", "0. Back to Main Menu", "")
                ]
                
                res_c = TUIEngine.select_option(reboot_opts, header_render_fn=lambda: render_section_header(device, "Reboot Target Device"), title="Reboot Options")
                if res_c == "0":
                    continue

                serial = device["serial"] if device else "11bb599a"
                is_simulated = device.get("is_simulated", False) if device else False
                target_map = {"1": "system", "2": "bootloader", "3": "recovery"}

                ok, res_out = fastboot_instance.reboot(serial, target_map[res_c], is_simulated=is_simulated)
                if ok:
                    console.print("\n[green]Reboot command sent to device.[/green]")
                else:
                    console.print(f"\n[red]Reboot failed: {res_out}[/red]")

            elif choice == "6":
                render_section_header(device, "Device Info & Security")
                if device:
                    console.print(f"  Model        : [cyan]{device['name']}[/cyan] ({device['product']})")
                    console.print(f"  Serial       : {device['serial']}")
                    console.print(f"  Anti-Roll    : [yellow]v{device['anti']}[/yellow]")
                    console.print(f"  Bootloader   : [green]{device['unlocked'].upper()}[/green]")
                    console.print(f"  Battery      : {device['battery']}")
                    console.print(f"  Driver Engine: {device['mode']}")
                    if "android_ver" in device:
                        console.print(f"  Android Ver  : [green]{device['android_ver']}[/green]")
                        console.print(f"  MIUI/OS Ver  : [yellow]{device['miui_ver']}[/yellow]")

            elif choice == "7":
                render_section_header(device, "Interactive Fastboot CLI Shell")
                FastbootShell.run_interactive_shell(fastboot_instance, device)

            elif choice == "8":
                adb_opts = [
                    ("1", "Reboot to Fastboot Mode", "adb reboot bootloader"),
                    ("2", "Reboot to Recovery Mode", "adb reboot recovery"),
                    ("3", "Sideload OTA / Recovery package (.zip)", "adb sideload file.zip"),
                    ("4", "Read system properties", "adb shell getprop"),
                    ("5", "Custom ADB Shell command", "adb shell <cmd>"),
                    ("0", "0. Back to Main Menu", "")
                ]

                adb_c = TUIEngine.select_option(adb_opts, header_render_fn=lambda: render_section_header(device, "ADB OTG Utilities & Sideload"), title="ADB Options")
                serial = device["serial"] if device else "11bb599a"

                if adb_c == "1":
                    fastboot_instance.adb_ctrl.reboot(serial, "bootloader")
                    console.print("[green]Sent: adb reboot bootloader[/green]")

                elif adb_c == "2":
                    fastboot_instance.adb_ctrl.reboot(serial, "recovery")
                    console.print("[green]Sent: adb reboot recovery[/green]")

                elif adb_c == "3":
                    zip_p = TUIEngine.file_browser("/sdcard/Download", allowed_exts=['.zip'], header_render_fn=lambda: render_section_header(device, "Select Recovery OTA ZIP File"), title="ADB Sideload ZIP Browser")
                    if zip_p and os.path.exists(zip_p):
                        fastboot_instance.adb_ctrl.sideload(serial, zip_p, callback=lambda m, s: console.print(f"[{s}] {m}"))
                    elif zip_p:
                        console.print(f"[red]Error: ZIP file '{zip_p}' missing.[/red]")

                elif adb_c == "4":
                    props = fastboot_instance.adb_ctrl.get_device_props(serial)
                    console.print("\nDevice Properties:")
                    for k, v in props.items():
                        console.print(f"  {k:<14}: [cyan]{v}[/cyan]")

                elif adb_c == "5":
                    cmd_str = Prompt.ask("ADB shell command", default="getprop ro.product.model")
                    ok_sh, out_sh = fastboot_instance.adb_ctrl.shell(serial, cmd_str)
                    if ok_sh:
                        console.print(f"\n{out_sh}")
                    else:
                        console.print(f"[red]ADB shell error: {out_sh}[/red]")

            elif choice == "0":
                graceful_exit()

            Prompt.ask("\nPress Enter to return to main menu", default="")
            device, msg = fastboot_instance.scan_devices()

        except (KeyboardInterrupt, EOFError):
            graceful_exit()

if __name__ == "__main__":
    main()
